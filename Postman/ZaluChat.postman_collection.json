          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (list.length) { pm.collectionVariables.set('lastMessageId', list[list.length-1].messageId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Tin mới (polling)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{roomId}}/messages?afterId={{lastMessageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{roomId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "afterId",
                  "value": "{{lastMessageId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (list.length) { pm.collectionVariables.set('lastMessageId', list[list.length-1].messageId); }"
                ]
              }
            }
          ]
        },
