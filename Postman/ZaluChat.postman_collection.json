    {
      "name": "5. Tin nhắn",
      "item": [
        {
          "name": "50 tin gần nhất",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{roomId}}/messages",
              "host": [
